                      ],
                      "children": [
                        {
                          "type": "frame",
                          "id": "ojL6z",
                          "name": "Story Row",
                          "width": "fill_container",
                          "gap": 80,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "frame",
                              "id": "H1mj2G",
                              "name": "Story",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 24,
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "mahj7",
                                  "name": "Eyebrow",
                                  "gap": 8,
                                  "alignItems": "center",
                                  "children": [
                                    {
                                      "type": "rectangle",
                                      "id": "GtO7Z",
                                      "name": "Tick",
                                      "fill": "#ff6600",
                                      "width": 8,
                                      "height": 8
                                    },
                                    {
                                      "type": "text",
                                      "id": "xLAq2",
                                      "name": "Eyebrow Label",
                                      "fill": "#ff6600",
                                      "content": "THE INSIGHT",
                                      "fontFamily": "Geist Mono",
                                      "fontSize": 12,
                                      "fontWeight": "normal",
                                      "letterSpacing": 1.5
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "id": "r65Kp",
                                  "name": "Heading",
                                  "fill": "#fafafa",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Everyone is fighting over the 15%.",
                                  "lineHeight": 1.05,
                                  "fontFamily": "Outfit",
                                  "fontSize": 56,
                                  "fontWeight": "500",
                                  "letterSpacing": -1.5
                                },
                                {
                                  "type": "text",
                                  "id": "eEZu1",
                                  "name": "Story Body",
                                  "fill": "#a1a1aa",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "When Ajay Banga became CEO of Mastercard, he noticed the company's slogan called it the heart of commerce. Yet inside the building, everyone talked about Visa and American Express, rivals competing for the small share of payments that were already electronic.\n\nAlmost no one talked about the real competitor: cash, which at the time handled more than 85% of consumer transactions worldwide.¹",
                                  "lineHeight": 1.65,
                                  "fontFamily": "Roboto",
                                  "fontSize": 17,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "frame",
                                  "id": "tavC6",
                                  "name": "Kill Cash Line",
                                  "width": "fill_container",
                                  "stroke": "#ff6600",
                                  "strokeWidth": {
                                    "left": 2
                                  },
                                  "layout": "vertical",
                                  "gap": 6,
                                  "padding": [
                                    4,
                                    0,
                                    4,
                                    20
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "uh9sm",
                                      "name": "Lead",
                                      "fill": "#a1a1aa",
                                      "content": "So Banga rewrote the mission in two words:",
                                      "fontFamily": "Roboto",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "fJETi",
                                      "name": "Kill Cash",
                                      "fill": "#fafafa",
                                      "content": "kill cash.",
                                      "fontFamily": "Outfit",
                                      "fontSize": 40,
                                      "fontWeight": "500",
                                      "letterSpacing": -1,
                                      "fontStyle": "italic"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "id": "BaicO",
                                  "name": "Kill Cash Outcome",
                                  "fill": "#a1a1aa",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Mastercard stopped fighting over the 15% and went after the 85%.",
                                  "lineHeight": 1.65,
                                  "fontFamily": "Roboto",
                                  "fontSize": 17,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "epQjh",
                              "name": "Story Media",
                              "width": 500,
                              "layout": "vertical",
                              "gap": 12,
                              "children": [
                                {
                                  "type": "rectangle",
                                  "cornerRadius": 12,
                                  "id": "a6dHpT",
                                  "name": "Kill Cash Image",
                                  "fill": {
                                    "type": "image",
                                    "enabled": true,
                                    "url": "untitled-assets/generated-1.png",
                                    "mode": "fill"
                                  },
                                  "width": "fill_container",
                                  "height": 540,
                                  "stroke": "#ffffff1a",
                                  "strokeWidth": 1
                                },
                                {
