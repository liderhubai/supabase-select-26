                                  "name": "Caption",
                                  "fill": "#71717a",
                                  "content": "FIG. 01 — THE REAL COMPETITOR WAS NEVER VISA.",
                                  "fontFamily": "Geist Mono",
                                  "fontSize": 11,
                                  "fontWeight": "normal",
                                  "letterSpacing": 1
                                }
